{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bethnalgreen.live/schemas/event.schema.json",
  "title": "Event",
  "description": "A verified event, as the website and newsletter read it. Written only by the verifier (facts) and later the listing writer (the 'listing' block). Lives in data/events/<YYYY-MM>/<id>.json. Public text (the listing blurb) is written later from confirmed fields only; the scout's summary is not carried over.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "subcategory",
    "title",
    "venue",
    "starts_at",
    "zone",
    "price",
    "ticket_url",
    "status",
    "evidence",
    "verification",
    "first_seen",
    "updated_at"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/event_id"
    },
    "category": {
      "$ref": "common.schema.json#/$defs/category"
    },
    "subcategory": {
      "$ref": "common.schema.json#/$defs/subcategory"
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "venue": {
      "$ref": "common.schema.json#/$defs/venue"
    },
    "starts_at": {
      "$ref": "common.schema.json#/$defs/when"
    },
    "ends_at": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/when"
        },
        {
          "type": "null"
        }
      ]
    },
    "recurrence": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_schedule": {
      "description": "For runs (exhibitions, theatre runs, special menus over several days): opening days and times in the source's own words, e.g. 'Tue–Sun 11am–6pm' or 'Tue–Sat 7.30pm, Sat matinee 2.30pm'. Needs evidence like any other fact.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "zone": {
      "$ref": "common.schema.json#/$defs/zone"
    },
    "worth_the_trip": {
      "type": "boolean",
      "default": false
    },
    "lineup": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 30
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8
    },
    "price": {
      "$ref": "common.schema.json#/$defs/price"
    },
    "ticket_url": {
      "$ref": "common.schema.json#/$defs/ticket_url"
    },
    "age_restriction": {
      "type": [
        "string",
        "null"
      ]
    },
    "accessibility": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "evidence": {
      "description": "Only evidence items the verifier confirmed.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/evidence_item"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified_at",
        "run_id",
        "outcome",
        "record"
      ],
      "properties": {
        "verified_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "run_id": {
          "type": "string"
        },
        "outcome": {
          "description": "verified = every filled field confirmed; verified-with-gaps = key facts confirmed, some optional fields removed because they could not be confirmed.",
          "enum": [
            "verified",
            "verified-with-gaps"
          ]
        },
        "removed_fields": {
          "description": "Fields the scout filled in that the verifier could not confirm and therefore emptied.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "record": {
          "description": "Path to the verification record, e.g. data/verification/2026-10-13/<id>.json",
          "type": "string",
          "pattern": "^data/verification/"
        }
      }
    },
    "editor_note": {
      "description": "The scout's opinion (why_its_good), carried over for the newsletter editor. Internal only: never shown to the public.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 220
    },
    "listing": {
      "description": "Filled by the listing writer later. Null until then.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blurb",
            "written_at",
            "run_id"
          ],
          "properties": {
            "headline": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 100
            },
            "blurb": {
              "type": "string",
              "maxLength": 600
            },
            "written_at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "run_id": {
              "type": "string"
            }
          }
        }
      ]
    },
    "first_seen": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "history": {
      "description": "What changed after first publication, newest last.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "by",
          "change"
        ],
        "properties": {
          "at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "by": {
            "type": "string",
            "examples": [
              "verifier",
              "human"
            ]
          },
          "change": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "needs_review": {
      "description": "Set when something about a published event is in doubt (a held update, a page that vanished, a possible date change). The site must hide the event or show it as 'details being checked' while this is set.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "since",
            "reason"
          ],
          "properties": {
            "since": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "reason": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      ]
    }
  }
}
