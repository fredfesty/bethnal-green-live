{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bethnalgreen.live/schemas/candidate-event.schema.json",
  "title": "Candidate event",
  "description": "What a scout hands to the verifier. Every factual field that is filled in must be named by at least one evidence item. Lives in data/candidates/<category>/<run-date>/<id>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "scout",
    "found_at",
    "category",
    "subcategory",
    "title",
    "venue",
    "starts_at",
    "zone",
    "price",
    "ticket_url",
    "status",
    "evidence",
    "scout_confidence"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/event_id"
    },
    "scout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "run_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "examples": [
            "nights-music"
          ]
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+$"
        }
      }
    },
    "found_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "category": {
      "$ref": "common.schema.json#/$defs/category"
    },
    "subcategory": {
      "$ref": "common.schema.json#/$defs/subcategory"
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "summary": {
      "description": "One or two neutral sentences in our own words, max 40 words. No copied promo text, no opinions, no facts that are not in evidence.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 320
    },
    "venue": {
      "$ref": "common.schema.json#/$defs/venue"
    },
    "starts_at": {
      "$ref": "common.schema.json#/$defs/when"
    },
    "ends_at": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/when"
        },
        {
          "type": "null"
        }
      ]
    },
    "recurrence": {
      "description": "Only for regular nights, in the source's own words, e.g. 'every Sunday'. Feeds the 'On repeat' section.",
      "type": [
        "string",
        "null"
      ]
    },
    "run_schedule": {
      "description": "For runs (exhibitions, theatre runs, special menus over several days): opening days and times in the source's own words, e.g. 'Tue–Sun 11am–6pm' or 'Tue–Sat 7.30pm, Sat matinee 2.30pm'. Needs evidence like any other fact.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "zone": {
      "$ref": "common.schema.json#/$defs/zone"
    },
    "worth_the_trip": {
      "type": "boolean",
      "default": false
    },
    "lineup": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 30
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 8
    },
    "price": {
      "$ref": "common.schema.json#/$defs/price"
    },
    "ticket_url": {
      "$ref": "common.schema.json#/$defs/ticket_url"
    },
    "age_restriction": {
      "type": [
        "string",
        "null"
      ]
    },
    "accessibility": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/evidence_item"
      }
    },
    "scout_confidence": {
      "description": "high = date, time and venue quoted from a primary source; medium = primary but something missing, or the venue has no primary listing anywhere; low = aggregator or reader tip only.",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "why_its_good": {
      "description": "The scout's opinion for the editor, max 30 words. Must not introduce facts that are not in evidence.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 220
    },
    "notes_for_verifier": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 400
    }
  }
}
