{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bethnalgreen.live/schemas/common.schema.json",
  "title": "Shared definitions",
  "description": "Building blocks reused by the candidate, event and verification formats.",
  "$defs": {
    "event_id": {
      "description": "YYYY-MM-DD-<venue-id>-<title-slug>, lowercase, hyphens only. The same event must always get the same id.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "when": {
      "description": "ISO 8601 with Europe/London offset (2026-10-16T22:00:00+01:00), or a bare date (2026-10-16) when the source gives no time.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[+-][0-9]{2}:[0-9]{2}))?$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "category": { "enum": ["nights-music", "arts", "food-drink", "community"] },
    "subcategory": {
      "description": "Extend this list when a new scout is added.",
      "enum": [
        "club-night", "gig", "dj-bar", "queer-party", "cabaret-drag",
        "karaoke", "jazz", "open-mic", "folk-acoustic", "in-store",
        "festival", "other"
      ]
    },
    "zone": { "enum": ["core", "fringe", "outer"] },
    "status": { "enum": ["scheduled", "sold-out", "cancelled", "postponed", "few-left"] },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "venue_id"],
      "properties": {
        "venue_id": {
          "description": "id from data/sources/<category>.json, or null if the venue is not in the registry yet.",
          "type": ["string", "null"]
        },
        "name": { "type": "string", "minLength": 2 },
        "address": { "type": ["string", "null"] },
        "postcode": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{1,2}[0-9][0-9A-Z]? ?[0-9][A-Z]{2}$"
        }
      }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known"],
      "properties": {
        "known": { "type": "boolean", "description": "False when the source states no price. Never guess." },
        "is_free": { "type": ["boolean", "null"] },
        "min_gbp": { "type": ["number", "null"], "minimum": 0 },
        "max_gbp": { "type": ["number", "null"], "minimum": 0 },
        "notes": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "url", "quote", "retrieved_at", "source_kind"],
      "properties": {
        "fields": {
          "description": "Which record fields this quote supports, e.g. ['starts_at','price']. 'venue' covers venue.*, 'price' covers price.*.",
          "type": "array", "minItems": 1, "items": { "type": "string" }
        },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "quote": {
          "description": "One contiguous snippet copied word for word from the page, max 300 characters. Never stitch separate bits together; use one evidence item per snippet.",
          "type": "string", "minLength": 3, "maxLength": 300
        },
        "retrieved_at": { "$ref": "#/$defs/timestamp" },
        "source_kind": {
          "description": "primary = venue's own site or the ticket page for this event; aggregator = a listings site that copies others; reader-tip = sent in by a reader.",
          "enum": ["primary", "aggregator", "reader-tip"]
        }
      }
    }
  }
}
