---
import Base from "../layouts/Base.astro";
import Subscribe from "../components/Subscribe.astro";
---
<Base title="Newsletter" current="newsletter" description="The best of what's on around Bethnal Green, every Thursday morning. Free.">
  <article class="prose">
    <h1>The newsletter</h1>
    <p>
      Every Thursday morning: the week ahead around E2 in a few minutes' reading. You get a pick of the week, the nights
      worth crossing the road for, what's on at the cinema, the regular nights, and dates to book now before they
      sell out.
    </p>
    <p>It's free, and every event in it has been checked the same way as the listings here.</p>
  </article>
  <Subscribe />
</Base>
