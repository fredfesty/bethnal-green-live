---
import Base from "../layouts/Base.astro";
import Subscribe from "../components/Subscribe.astro";
import { loadIssues, isOut } from "../lib/newsletter";
import { dayMonth } from "../lib/time";
import { rel } from "../lib/rel";
const here = Astro.url.pathname;
const issues = loadIssues().filter(isOut);
---
<Base title="Newsletter" current="newsletter" description="The best of what's on around Bethnal Green, every Thursday morning. Free.">
  <article class="prose">
    <h1>The newsletter</h1>
    <p>
      Every Thursday morning: the week ahead around E2 in a few minutes' reading. A short note from Fred, a pick of
      the week, the nights worth crossing the road for, the free and cheap ones, and dates to book now before they
      sell out.
    </p>
    <p>It's free, and every event in it has been checked the same way as the listings here.</p>
  </article>
  <Subscribe />
  {issues.length > 0 && (
    <section class="archive" aria-labelledby="archive-title">
      <h2 id="archive-title">Past issues</h2>
      <ul>
        {issues.map((i) => (
          <li>
            <a href={rel(here, `newsletter/${i.id}.html`)}><strong>Issue {i.issue_number}</strong> · {dayMonth(i.id)}</a>
            <span>{i.preheader}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .archive { max-width: 44rem; margin-top: 3rem; }
  .archive h2 { font-size: 1.35rem; font-weight: 700; }
  .archive ul { list-style: none; margin: 0.75rem 0 0; padding: 0; }
  .archive li { padding: 0.75rem 0; border-top: 1px solid var(--rule); }
  .archive li:first-child { border-top: 0; }
  .archive a { color: var(--ink); text-decoration-color: var(--rule); }
  .archive span { display: block; color: var(--muted); font-size: 0.95rem; margin-top: 0.15rem; }
</style>
