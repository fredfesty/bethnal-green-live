---
import Base from "../../layouts/Base.astro";
import { loadEvents, mapLink, type SiteEvent } from "../../lib/data";
import { kindLabel, STATUS, ZONE } from "../../lib/labels";
import { timeRange, weekday, dayMonth, longDate, hasTime, londonDate, dayMonthShort } from "../../lib/time";
import { rel } from "../../lib/rel";
import { venuePathFor } from "../../lib/venues";
import { linkSources, type Segment } from "../../lib/storylinks";
import { shownStory } from "../../lib/eventstory";
import config from "../../site.config.mjs";
import { calendarEntry } from "../../lib/ics";
import { calendarLinks } from "../../lib/calendarlinks";

export function getStaticPaths() {
  return loadEvents().map((e) => ({ params: { id: e.id }, props: { e } }));
}

const { e } = Astro.props as { e: SiteEvent };
const here = Astro.url.pathname;
const kind = kindLabel(e);
const pageUrl = new URL(`events/${e.id}.html`, Astro.site).href;
const checked = londonDate(new Date(e.verification.verified_at));
const statusSchema: Record<string, string> = {
  cancelled: "https://schema.org/EventCancelled",
  postponed: "https://schema.org/EventPostponed",
};
const SCHEMA_TYPE: Record<string, string> = {
  theatre: "TheaterEvent", comedy: "ComedyEvent", film: "ScreeningEvent", exhibition: "ExhibitionEvent",
  dance: "DanceEvent", festival: "Festival", sport: "SportsEvent", workshop: "EducationEvent", "cookery-class": "EducationEvent",
  talk: "EducationEvent", retreat: "EducationEvent", run: "SportsEvent", fitness: "SportsEvent", "open-studios": "VisualArtsEvent", market: "SaleEvent", fair: "SaleEvent",
};
const jsonld = {
  "@context": "https://schema.org",
  "@type": SCHEMA_TYPE[e.subcategory] ?? (e.category === "nights-music" ? "MusicEvent" : e.category === "food-drink" ? "FoodEvent" : "Event"),
  name: e.title,
  startDate: e.starts_at,
  ...(e.ends_at ? { endDate: e.ends_at } : {}),
  eventStatus: statusSchema[e.status] ?? "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: e.venue.name,
    address: { "@type": "PostalAddress", streetAddress: e.venue.address ?? undefined, postalCode: e.venue.postcode ?? undefined, addressLocality: "London", addressCountry: "GB" },
  },
  ...(e.lineup?.length ? { performer: e.lineup.map((name) => ({ "@type": "PerformingGroup", name })) } : {}),
  ...(e.price.known && e.ticket_url
    ? { offers: { "@type": "Offer", url: e.ticket_url, price: e.price.is_free ? 0 : e.price.min_gbp, priceCurrency: "GBP",
        availability: e.status === "sold-out" ? "https://schema.org/SoldOut" : "https://schema.org/InStock" } }
    : {}),
  url: pageUrl,
};
const vpath = venuePathFor(e);
// "Add to my calendar": the web calendars open pre-filled; Apple Calendar and other apps take the .ics file.
const calLinks = calendarLinks(calendarEntry(e, pageUrl));
// "The story", once the event story checker has stamped it; the sites it names link to the pages the facts came from.
const story = shownStory(e.story);
const sl = (part: string, text: string): Segment[] => linkSources(text, part, story?.evidence ?? []);
const mail = config.correctionsContact;
const fixHref = !mail ? null : mail.includes("@")
  ? `mailto:${mail}?subject=${encodeURIComponent(`Correction: ${e.title} (${e.date})`)}&body=${encodeURIComponent(`Listing: ${pageUrl}\n\nWhat's wrong:\n`)}`
  : mail;
---
<Base title={e.title} description={e.listing?.blurb ? `${e.listing.blurb} ${e.isRun ? `Until ${dayMonth(e.until)}` : `${weekday(e.date)} ${dayMonth(e.date)}`}. ${e.priceLabel}.` : e.isRun ? `${kind} at ${e.venue.name}, until ${dayMonth(e.until)}. ${e.priceLabel}.` : `${kind} at ${e.venue.name}, ${weekday(e.date)} ${dayMonth(e.date)}. ${e.priceLabel}.`} jsonld={jsonld}>
  <article class="ev">
    <p class="ev__back"><a href={rel(here, "index.html")}>Back to all listings</a></p>

    <p class="plate plate--date">
      {e.isRun
        ? <span>{dayMonth(e.date)} to {dayMonth(e.until)}</span>
        : <span>{weekday(e.date)} {dayMonth(e.date)}</span>}
      {!e.isRun && hasTime(e.starts_at) && <span class="plate__district">{timeRange(e.starts_at, e.ends_at)}</span>}
    </p>

    <h1>{e.title}</h1>
    <p class="ev__kind">{kind} at <a href={rel(here, vpath)}>{e.venue.name}</a></p>

    {STATUS[e.status] && (
      <p class:list={["ev__status", `ev__status--${e.status}`]} role="status">
        {e.status === "cancelled" && "This event has been cancelled."}
        {e.status === "postponed" && "This event has been postponed. Check the ticket page for the new date."}
        {e.status === "sold-out" && "Sold out. The ticket page may have returns or a waiting list."}
        {e.status === "few-left" && "The last few tickets are on sale."}
      </p>
    )}

    {e.listing?.blurb && <p class="ev__blurb">{e.listing.blurb}</p>}

    <div class="ev__grid">
      <dl class="ev__facts">
        <div><dt>When</dt><dd>
          {e.isRun
            ? <>From {longDate(e.date)}<br />until {longDate(e.until)}{e.run_schedule && <><br />Open: {e.run_schedule}</>}</>
            : <>{longDate(e.date)}<br />{timeRange(e.starts_at, e.ends_at)}</>}
          {e.recurrence && <><br />Regular: {e.recurrence}</>}
        </dd></div>
        <div>
          <dt>Where</dt>
          <dd>
            {e.venue.name}
            {(e.venue.address || e.venue.postcode) && <><br />{[e.venue.address, e.venue.postcode].filter(Boolean).join(", ")}</>}
            <br /><a href={mapLink(e)}>Show on a map</a>
            <br /><a href={rel(here, vpath)}>About this venue: access, crowd and cost</a>
            {e.zone === "outer" && <><br /><span class="ev__note">{ZONE.outer}: a bit further from Bethnal Green than most listings.</span></>}
          </dd>
        </div>
        <div><dt>Price</dt><dd>{e.priceLabel}{e.price.notes && <><br /><span class="ev__note">{e.price.notes}</span></>}</dd></div>
        {e.lineup && e.lineup.length > 0 && <div><dt>Line-up</dt><dd>{e.lineup.join(", ")}</dd></div>}
        {e.genres && e.genres.length > 0 && <div><dt>Music</dt><dd>{e.genres.join(", ")}</dd></div>}
        {e.age_restriction && <div><dt>Age</dt><dd>{e.age_restriction}</dd></div>}
        <div><dt>Access</dt><dd>{e.accessibility ?? <span class="ev__note">Not listed. Check with the venue before you go.</span>}</dd></div>
      </dl>

      <div class="ev__actions">
        {e.ticket_url && e.status !== "cancelled" && (
          <a class="button" href={e.ticket_url} rel="noopener">{e.price.is_free ? "Event page" : "Get tickets"}</a>
        )}
        <details class="cal">
          <summary class="button button--quiet">Add to my calendar</summary>
          <ul class="cal__menu">
            {calLinks.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>)}
            <li><a href={rel(here, `events/${e.id}.ics`)} download>Apple Calendar or other app (.ics)</a></li>
          </ul>
        </details>
      </div>
    </div>

    {story && (
      <section class="ev__story" aria-labelledby="story-head">
        <h2 id="story-head">The story</h2>
        {story.who && <><h3>Who's on</h3><p>{sl("who", story.who).map((s) => s.href ? <a href={s.href} rel="noopener">{s.text}</a> : s.text)}</p></>}
        {(story.started || story.then) && <h3>{e.recurrence ? "The night" : "Background"}</h3>}
        {story.started && <p class="ev__started"><strong>Started:</strong> {sl("started", story.started).map((s) => s.href ? <a href={s.href} rel="noopener">{s.text}</a> : s.text)}</p>}
        {story.then && <p>{sl("then", story.then).map((s) => s.href ? <a href={s.href} rel="noopener">{s.text}</a> : s.text)}</p>}
        {story.now && <><h3>This time</h3><p>{sl("now", story.now).map((s) => s.href ? <a href={s.href} rel="noopener">{s.text}</a> : s.text)}</p></>}
        {story.vibe && <><h3>What it's like</h3><p>{sl("vibe", story.vibe).map((s) => s.href ? <a href={s.href} rel="noopener">{s.text}</a> : s.text)}</p></>}
        {(story.worth_knowing?.length ?? 0) > 0 && (
          <><h3>Worth knowing</h3><ul class="ev__worth">{story.worth_knowing!.map((w) => <li>{sl("worth_knowing", w).map((s) => s.href ? <a href={s.href} rel="noopener">{s.text}</a> : s.text)}</li>)}</ul></>
        )}
      </section>
    )}

    <section class="ev__checked" aria-labelledby="checked">
      <h2 id="checked">How we checked this</h2>
      <p>
        Checked on {dayMonthShort(checked)} against
        {e.sources.map((s, i) => (
          <>{i > 0 && (i === e.sources.length - 1 ? " and " : ", ")}<a href={s.url} rel="noopener">{s.host}</a>{s.kind === "primary" ? " (the event's own page)" : " (a listings site)"}</>
        ))}.
        {(e.verification.removed_fields?.length ?? 0) > 0 && " Some details weren't on those pages, so we've left them out."}
        {" "}Plans change, so check the ticket page before you go.
      </p>
      {fixHref && <p><a href={fixHref}>Spotted a mistake? Tell us</a></p>}
    </section>
  </article>
</Base>

<script>
  // The calendar menu works without JavaScript; this just closes it on Escape or a click elsewhere.
  for (const d of document.querySelectorAll<HTMLDetailsElement>("details.cal")) {
    document.addEventListener("click", (ev) => { if (d.open && !d.contains(ev.target as Node)) d.open = false; });
    d.addEventListener("keydown", (ev) => { if (ev.key === "Escape" && d.open) { d.open = false; d.querySelector("summary")?.focus(); } });
  }
</script>

<style>
  .ev { max-width: 52rem; }
  .ev__back { margin: 0.5rem 0 1.5rem; }
  .plate--date { font-size: 1.5rem; margin: 0 0 1.25rem 5px; flex-wrap: wrap; }
  .plate--date .plate__district { font-size: 0.7em; }
  .ev h1 { font-size: clamp(2rem, 6vw, 3.2rem); font-variation-settings: "wdth" 75; font-weight: 800; line-height: 1.02; }
  .ev__kind { font-size: 1.15rem; margin: 0.6rem 0 0; }
  .ev__status {
    margin: 1.25rem 0 0; padding: 0.75rem 1rem; border-left: 4px solid var(--red); background: #fff; font-weight: 600;
  }
  .ev__status--few-left { border-left-color: #b86a00; }
  .ev__grid { display: grid; grid-template-columns: 1fr auto; gap: 1.5rem 2.5rem; margin-top: 2rem; align-items: start; }
  .ev__facts { margin: 0; display: grid; gap: 0.9rem; }
  .ev__facts > div { display: grid; grid-template-columns: 6rem 1fr; gap: 1rem; padding-top: 0.9rem; border-top: 1px solid var(--rule); }
  .ev__facts > div:first-child { border-top: 0; padding-top: 0; }
  .ev__facts dt { font-weight: 700; }
  .ev__facts dd { margin: 0; }
  .ev__note { color: var(--muted); font-size: 0.95rem; }
  .ev__actions { display: grid; gap: 0.6rem; min-width: 13rem; }
  .cal summary { list-style: none; width: 100%; }
  .cal summary::-webkit-details-marker { display: none; }
  .cal summary::after { content: ""; width: 0.45em; height: 0.45em; border: solid currentColor; border-width: 0 2px 2px 0; transform: rotate(45deg) translateY(-2px); transition: transform 0.15s; }
  .cal[open] summary::after { transform: rotate(-135deg) translateY(-2px); }
  .cal__menu { list-style: none; margin: 0.4rem 0 0; padding: 0.3rem 0; border: 1px solid var(--rule); border-radius: 6px; background: #fff; }
  .cal__menu a { display: block; padding: 0.55rem 1rem; color: var(--green); font-weight: 600; text-decoration: none; }
  .cal__menu a:hover, .cal__menu a:focus-visible { background: var(--green-tint); }
  .ev__blurb { margin: 1rem 0 0; font-size: 1.15rem; line-height: 1.5; max-width: var(--measure); }
  .ev__story { margin-top: 2.5rem; max-width: var(--measure); }
  .ev__story h2 { font-size: 1.35rem; font-weight: 750; }
  .ev__story h3 { font-size: 1rem; font-weight: 700; margin: 1.1rem 0 0; }
  .ev__story p { margin: 0.5rem 0 0; line-height: 1.6; }
  .ev__worth { margin: 0.5rem 0 0; padding-left: 1.2rem; display: grid; gap: 0.3rem; line-height: 1.6; }
  .ev__checked { margin-top: 2.5rem; padding: 1.1rem 1.25rem; background: var(--green-tint); border-radius: 8px; max-width: 46rem; }
  .ev__checked h2 { font-size: 1.05rem; }
  .ev__checked p { margin: 0.5rem 0 0; }
  @media (max-width: 40rem) {
    .ev__grid { grid-template-columns: 1fr; }
    .ev__facts > div { grid-template-columns: 1fr; gap: 0.2rem; }
    .ev__actions { min-width: 0; }
  }
</style>
